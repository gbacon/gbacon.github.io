---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BaseItemCard from "../../components/ui/BaseItemCard.astro";
import { getAllTags, getContentByTag } from "../../utils/tags";
import { getListingItem } from "../../utils/adapters";
import { slugifyTag } from "../../utils/tags";
import { SITE } from "../../config";
import AffiliateDisclosure from "../../components/AffiliateDisclosure.astro";
import { isAmazonUrl } from "../../utils/affiliate-links";
import { tagDescription } from "../../utils/descriptions";

export async function getStaticPaths() {
    const tags = await getAllTags();
    return tags.map((tag) => ({
        params: { tag: slugifyTag(tag.name) },
        props: { tagName: tag.name },
    }));
}

//const { tag } = Astro.params;
const { tagName } = Astro.props;

const content = await getContentByTag(tagName);
const description = tagDescription(
    tagName,
    content.map((item: any) => ({ title: item.data.title || item.id, collection: item.collection })),
);
const showDisclosure = content.some(
    (item: any) => item.data.external_url && isAmazonUrl(item.data.external_url),
);
---

<BaseLayout title={`#${tagName}`} description={description}>
    <header class="page-header">
        <h1 class="page-title">#{tagName}</h1>
        <p class="page-subtitle">Content tagged with "{tagName}"</p>
    </header>

    {showDisclosure && <AffiliateDisclosure />}

    <section class="item-list">
        {content.map((item) => {
            const listingItem = {
                title: item.data.title || item.id,
                description: item.data.description,
                date: item.data.date,
                authors: item.data.author,
                extraInput: item.data.journal || item.data.event || item.data.institution,
                tags: item.data.tags,
                externalUrl: item.data.external_url,
            };
            const href = `/${item.collection}/${item.id}/`;
            return <BaseItemCard {...listingItem} href={href} />;
        })}
    </section>
</BaseLayout>