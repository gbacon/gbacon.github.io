---
import {
  PAID_LINK_TEXT,
  isAmazonUrl,
  externalLinkRel,
} from '../utils/affiliate-links';

interface Props {
  href: string;
  class?: string;
  [key: string]: any;
}

const { href, class: className = "", ...rest } = Astro.props;

const paidText = isAmazonUrl(href) ? PAID_LINK_TEXT : '';
---

<a
  href={href}
  rel={externalLinkRel(href)}
  class={className}
  target="_blank"
  {...rest}
>
  <slot />{paidText}
</a>
